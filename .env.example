# Copy to .env (git-ignored, loaded at startup) or set these as environment variables.
# Variables already set in the environment take priority over this file.
OPENROUTER_API_KEY=
# openrouter/free picks an available free model. For client deliveries use a paid model id from openrouter.ai/models.
LEADAGENT_MODEL=openrouter/free
# Backups tried in order when the main model is busy (max 3), e.g. nvidia/nemotron-3-super-120b-a12b:free
# LEADAGENT_FALLBACK_MODELS=
# LEADAGENT_WRITER_MODEL=        # optional separate model for opening lines
# LEADAGENT_RPM=18               # free models allow 20 requests/minute
# LEADAGENT_CONCURRENCY=4
# LEADAGENT_WEB_SEARCH=0         # 1 = add OpenRouter web search (billed per result)
# LEADAGENT_MAX_PAGES=4
# medchron (medical chronologies) uses the LEADAGENT_* settings above unless these are set.
# Real medical records need a model provider that signed a BAA with you; see medchron/README.md.
# MEDCHRON_MODEL=
# MEDCHRON_FALLBACK_MODELS=
# MEDCHRON_BASE_URL=
# MEDCHRON_API_KEY=
# MEDCHRON_BAA=                  # set to yes only once the provider's BAA is signed
# freightq (freight quotes) uses the LEADAGENT_* settings above unless these are set.
# Use a paid model with zero data retention for a brokerage's real emails; see freightq/README.md.
# FREIGHTQ_MODEL=
# FREIGHTQ_FALLBACK_MODELS=
# FREIGHTQ_BASE_URL=
# FREIGHTQ_RPM=

# leadactor (the Apify Actor) uses the LEADAGENT_* settings above unless these are set.
# On Apify these come from Apify secrets instead; see leadactor/README.md. Paid runs refuse free models.
# LEADACTOR_MODEL=
# LEADACTOR_FALLBACK_MODELS=
